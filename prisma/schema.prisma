// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  PATIENT
  DOCTOR
  ADMIN
}

/// Reservation lifecycle (see src/appointment/appointment-state.ts for who may move where):
/// PENDING (waiting for the doctor) → CONFIRMED (by the doctor) → DERMEE_CONFIRMED (by Dermee)
/// → COMPLETED | NO_SHOW. CANCELLED and REJECTED end it early.
enum AppointmentState {
  PENDING
  CONFIRMED
  DERMEE_CONFIRMED
  COMPLETED
  CANCELLED
  REJECTED
  NO_SHOW
}

/// Order, payment and delivery are tracked independently (see src/orders/order-rules.ts).
enum OrderStatus {
  PENDING
  CONFIRMED
  REJECTED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum DeliveryStatus {
  NOT_SHIPPED
  SENT_TO_DELIVERY
  DELIVERED
}

/// Which of the three order statuses an OrderStatusHistory row is about.
enum OrderStatusField {
  STATUS
  PAYMENT
  DELIVERY
}

/// UNPUBLISHED products are hidden from the shop; ARCHIVED ones are kept only for order history.
enum ProductStatus {
  PUBLISHED
  UNPUBLISHED
  ARCHIVED
}

enum StockMovementReason {
  INITIAL
  ADJUSTMENT
  ORDER_PLACED
  ORDER_RELEASED
  RETURN
}

enum PaymentMethod {
  BARIDIMOB
  CIB
  CASH
}

enum WeekDay {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum ExceptionType {
  CANCELLED
  ADDED
  CHANGED
}

enum VisitMode {
  ONLINE
  ONSITE
}

/// Account access for every role. Doctor verification is tracked separately (DoctorApprovalStatus).
enum UserStatus {
  ACTIVE
  SUSPENDED
}

/// Verification of a doctor account by Dermee. Only APPROVED doctors are visible and bookable.
enum DoctorApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Which field an AccountStatusHistory row describes.
enum AccountStatusField {
  APPROVAL
  STATUS
}

/// Category for files a doctor uploads for verification.
enum DoctorDocumentType {
  MEDICAL_LICENSE
  DIPLOMA
  ID_CARD
  OTHER
}

/// Category for files a patient uploads (prescriptions, labs, etc.).
enum PatientDocumentType {
  PRESCRIPTION
  LAB_RESULT
  MEDICAL_REPORT
  INSURANCE
  OTHER
}

// ------------------- USER & ADDRESS -------------------

model User {
  id           String   @id @default(cuid())
  /// Full display name. Kept in sync with firstName + lastName.
  name         String
  firstName    String?
  lastName     String?
  email        String   @unique
  phoneNumber  String?
  /// Null when the user only signs in via OAuth (Google/Facebook).
  passwordHash String?
  googleId     String?  @unique
  facebookId   String?  @unique
  role         UserRole @default(PATIENT)
  addressId    String?  @unique
  address      Address? @relation(fields: [addressId], references: [id])

  /// Public URL path or storage key for profile avatar (patients, doctors, admins).
  profilePictureUrl String?

  status         UserStatus @default(ACTIVE)
  suspendedAt    DateTime?
  suspendReason  String?
  /// Updated at most every few minutes by the JWT strategy.
  lastActivityAt DateTime?

  doctorProfile  Doctor?
  patientProfile Patient?
  messages       Message[] @relation("senderMessages")
  received       Message[] @relation("receiverMessages")

  notifications Notification[]
  statusHistory AccountStatusHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role, createdAt])
  @@index([status])
  @@index([phoneNumber])
  @@index([createdAt])
}

model Address {
  id         String  @id @default(cuid())
  street     String
  /// Commune
  city       String
  /// Wilaya
  state      String
  postalCode String
  country    String
  validated  Boolean @default(false)

  user      User?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([state, city])
}

// ------------------- DOCTOR / PATIENT -------------------

model Doctor {
  id        String  @id @default(cuid())
  userId    String  @unique
  user      User    @relation(fields: [userId], references: [id])
  fees      Float
  workYears Int
  about     String?
  specialty String?

  approvalStatus  DoctorApprovalStatus @default(PENDING)
  /// When the latest approval/rejection decision was made, and by which admin (User.id).
  approvedAt      DateTime?
  approvedById    String?
  rejectionReason String?

  workDays           WorkDay[]
  appointments       Appointment[]
  scheduleExceptions ScheduleException[]
  leaves             DoctorLeave[]
  documents          DoctorDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([approvalStatus])
}

/// Verification files (license, diploma...). Stored outside the public uploads folder.
model DoctorDocument {
  id           String             @id @default(cuid())
  doctorId     String
  doctor       Doctor             @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  /// Path relative to the private storage root.
  storageKey   String
  fileName     String
  mimeType     String?
  size         Int?
  documentType DoctorDocumentType @default(OTHER)
  title        String?
  createdAt    DateTime           @default(now())

  @@index([doctorId])
}

/// Every change of a user's account status or a doctor's approval status.
model AccountStatusHistory {
  id        String             @id @default(cuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  field     AccountStatusField
  fromValue String?
  toValue   String
  /// Admin who made the change (User.id). No foreign key: history outlives accounts.
  actorId   String?
  reason    String?
  createdAt DateTime           @default(now())

  @@index([userId, createdAt])
}

model Patient {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  appointments Appointment[]
  cart         Cart?
  orders       Order[]
  wishlist     Wishlist[]
  documents    PatientDocument[]
  ratings      ProductRating[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Uploaded files tied to a patient (prescriptions, labs, insurance scans, etc.).
model PatientDocument {
  id        String  @id @default(cuid())
  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  /// API path the client uses to download the file (needs authentication).
  fileUrl    String
  /// Path relative to the private storage root. Null for files uploaded before private storage.
  storageKey String?
  /// Original filename from the client (for display/download).
  fileName   String
  mimeType   String?

  documentType PatientDocumentType @default(OTHER)
  /// Optional short label shown in the UI (e.g. “Spring 2025 checkup”).
  title        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId])
}

// ------------------- APPOINTMENTS -------------------

model Appointment {
  id        String           @id @default(cuid())
  doctorId  String
  patientId String
  type      String
  visitMode VisitMode        @default(ONSITE)
  state     AppointmentState @default(PENDING)
  startAt   DateTime
  endAt     DateTime

  /// Set when an online visit is approved and a Google Calendar event with Meet is created
  meetLink              String?
  googleCalendarEventId String?

  /// Human-friendly reference, shown as RSV-000123.
  refNo           Int      @unique @default(autoincrement())
  /// Last time the state changed (sortable "last status update").
  statusChangedAt DateTime @default(now())
  cancelledById   String?
  cancelReason    String?

  doctor     Doctor                     @relation(fields: [doctorId], references: [id])
  patient    Patient                    @relation(fields: [patientId], references: [id])
  report     AppointmentReport?
  history    AppointmentStatusHistory[]
  adminNotes AppointmentAdminNote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([state, startAt])
  @@index([doctorId, startAt])
  @@index([patientId])
  @@index([createdAt])
}

/// Every state change of a reservation, with who did it.
model AppointmentStatusHistory {
  id            String            @id @default(cuid())
  appointmentId String
  appointment   Appointment       @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  fromState     AppointmentState?
  toState       AppointmentState
  /// User.id of the actor; null for the system (scheduled jobs).
  actorId       String?
  actorRole     String
  note          String?
  createdAt     DateTime          @default(now())

  @@index([appointmentId, createdAt])
}

/// Internal follow-up notes written by Dermee staff. Never shown to doctors or patients.
model AppointmentAdminNote {
  id            String      @id @default(cuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  authorId      String
  content       String
  createdAt     DateTime    @default(now())

  @@index([appointmentId, createdAt])
}

model AppointmentReport {
  id            String      @id @default(cuid())
  appointmentId String      @unique
  description   String
  type          String
  appointment   Appointment @relation(fields: [appointmentId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ------------------- WORKDAY -------------------

model WorkDay {
  id        String   @id @default(cuid())
  doctorId  String
  day       WeekDay
  startTime DateTime
  endTime   DateTime

  doctor    Doctor   @relation(fields: [doctorId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([doctorId, day])
}

// * defines temporary overrides (“not available on Oct 21”)
// * avoids polluting your base schedule with ad-hoc entries. Keeps historical accuracy.
// * we can support many types of exceptions (cancel, added, changed, etc.) easily.
// * Base schedule is small (max 7 entries). Exceptions can grow large without affecting weekly logic.
// * You can track who created the exception, why, when, etc.
// * scalability
model ScheduleException {
  id        String        @id @default(uuid())
  doctorId  String
  doctor    Doctor        @relation(fields: [doctorId], references: [id])
  date      DateTime
  type      ExceptionType
  start     String?
  end       String?
  reason    String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([doctorId, date]) // prevent multiple exceptions for same date
}

model DoctorLeave {
  id        String   @id @default(cuid())
  doctorId  String
  doctor    Doctor   @relation(fields: [doctorId], references: [id])
  startDate DateTime
  endDate   DateTime
  reason    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ------------------- CHAT & MESSAGES -------------------

// ------------------- NOTIFICATIONS -------------------

model Notification {
  id      String    @id @default(cuid())
  userId  String
  content String
  read    Boolean   @default(false)
  readAt  DateTime?

  /// Machine-readable kind, e.g. RESERVATION_PENDING_DOCTOR, DOCTOR_APPROVED.
  type       String  @default("GENERAL")
  /// What the notification is about, so the UI can open it.
  entityType String?
  entityId   String?
  link       String?
  /// Stops the same alert being created twice for one user (scheduled checks re-run).
  dedupeKey  String?

  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, dedupeKey])
  @@index([userId, read, createdAt])
}

// ------------------- PRODUCTS / E-COMMERCE -------------------

model Product {
  id          String  @id @default(cuid())
  name        String
  description String?
  brand       String?
  price       Float
  category    String?
  rating      Float   @default(0.0)

  /// Product reference. Optional, unique when set.
  sku               String?       @unique
  /// Units available. Never negative (CHECK constraint + conditional updates).
  stock             Int           @default(0)
  /// Low-stock alert level; falls back to the defaultLowStockThreshold setting.
  lowStockThreshold Int?
  status            ProductStatus @default(UNPUBLISHED)
  archivedAt        DateTime?

  images         ProductImage[]
  cartItems      CartItem[]
  wishlist       Wishlist[]
  orderItems     OrderItem[]
  ratings        ProductRating[]
  stockMovements StockMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([category])
}

/// Every change of Product.stock, with the reason and who/what caused it.
model StockMovement {
  id         String              @id @default(cuid())
  productId  String
  product    Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// Positive = stock added, negative = stock removed.
  delta      Int
  stockAfter Int
  reason     StockMovementReason
  /// User.id of the admin, or the patient for order-related movements. No FK.
  actorId    String?
  orderId    String?
  note       String?
  createdAt  DateTime            @default(now())

  @@index([productId, createdAt])
  @@index([orderId])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  isPrimary Boolean @default(false)
  order     Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model ProductRating {
  id        String  @id @default(cuid())
  productId String
  patientId String
  score     Int
  review    String?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  patient Patient @relation(fields: [patientId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, patientId])
}

model Cart {
  id        String     @id @default(cuid())
  patientId String     @unique
  patient   Patient    @relation(fields: [patientId], references: [id])
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String @id @default(cuid())
  cartId    String
  productId String
  quantity  Int    @default(1)

  cart    Cart    @relation(fields: [cartId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([cartId, productId])
}

model Wishlist {
  id        String @id @default(cuid())
  patientId String
  productId String

  patient   Patient  @relation(fields: [patientId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())

  @@unique([patientId, productId])
}

// ------------------- ORDERS -------------------

model Order {
  id        String        @id @default(cuid())
  /// Human-friendly reference, shown as ORD-000045.
  refNo     Int           @unique @default(autoincrement())
  patientId String
  /// CASH = cash on delivery.
  payMethod PaymentMethod

  status         OrderStatus    @default(PENDING)
  paymentStatus  PaymentStatus  @default(PENDING)
  deliveryStatus DeliveryStatus @default(NOT_SHIPPED)

  /// Sum of item subtotals at order time.
  totalAmount Float @default(0)

  // Delivery address, copied at order time so later profile edits don't change past orders.
  recipientName  String?
  recipientPhone String?
  wilaya         String?
  commune        String?
  addressLine    String?
  deliveryNote   String?

  deliveryCompany String?
  trackingNumber  String?
  shippedAt       DateTime?
  deliveredAt     DateTime?
  paidAt          DateTime?
  /// Reason given when the order was rejected or cancelled.
  closeReason     String?

  patient Patient              @relation(fields: [patientId], references: [id])
  items   OrderItem[]
  history OrderStatusHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([paymentStatus])
  @@index([deliveryStatus])
  @@index([patientId, createdAt])
  @@index([createdAt])
  @@index([wilaya, commune])
}

/// Every change of an order's status, payment status or delivery status (and delivery updates).
model OrderStatusHistory {
  id        String           @id @default(cuid())
  orderId   String
  order     Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  field     OrderStatusField
  fromValue String?
  toValue   String
  actorId   String?
  actorRole String
  note      String?
  createdAt DateTime         @default(now())

  @@index([orderId, createdAt])
}

model OrderItem {
  id          String @id @default(cuid())
  orderId     String
  productId   String
  productName String
  unitPrice   Float
  quantity    Int

  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

model Message {
  id         String   @id @default(cuid())
  content    String
  senderId   String
  receiverId String
  createdAt  DateTime @default(now())

  sender   User @relation("senderMessages", fields: [senderId], references: [id])
  receiver User @relation("receiverMessages", fields: [receiverId], references: [id])

  @@index([receiverId])
  @@index([senderId])
}

// ------------------- ADMINISTRATION -------------------

/// Append-only record of sensitive actions (admin decisions, status changes, exports, impersonation).
/// actorId has no foreign key on purpose: logs must outlive the user rows they mention.
model AuditLog {
  id             String   @id @default(cuid())
  /// Null when the system did the action (scheduled jobs).
  actorId        String?
  actorEmail     String?
  /// Set when the action happened during an impersonation session.
  impersonatorId String?
  action         String
  entityType     String
  entityId       String?
  before         Json?
  after          Json?
  metadata       Json?
  ip             String?
  createdAt      DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
}

/// Admin-editable configuration (urgency thresholds, low-stock threshold...).
model SystemSetting {
  key         String   @id
  value       Json
  updatedById String?
  updatedAt   DateTime @updatedAt
}

/// Read-only "view as user" sessions started by an administrator.
/// The admin's own login is untouched; the session token is short-lived and refused for any write.
model ImpersonationSession {
  id           String    @id @default(cuid())
  adminId      String
  targetUserId String
  reason       String?
  startedAt    DateTime  @default(now())
  expiresAt    DateTime
  endedAt      DateTime?
  /// Why it ended: EXITED (admin left), REPLACED (admin started another one), EXPIRED.
  endReason    String?
  ip           String?
  userAgent    String?

  @@index([adminId, startedAt])
  @@index([targetUserId, startedAt])
}
